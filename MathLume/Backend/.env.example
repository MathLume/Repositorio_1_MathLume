# Copie este arquivo para ".env" e ajuste. O ".env" NÃO vai para o GitHub (tem senha!).
# Na hospedagem (Render etc.), cadastre estas mesmas variáveis no painel, não no arquivo.

# Connection string do Neon: painel do Neon > seu projeto > botão "Connect".
# Use a versão "pooled" (o endereço tem "-pooler" no meio). Exemplo:
DATABASE_URL=postgresql://usuario:senha@ep-xxxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require

PORT=3000

# ADM criado automaticamente na 1ª vez que o servidor sobe (só se ainda não existir nenhum ADM).
# Se ADMIN_SENHA ficar vazia, uma senha aleatória é gerada e mostrada no console/log.
ADMIN_USUARIO=admin
ADMIN_EMAIL=admin@mathlume.com
ADMIN_SENHA=

# Coloque 1 quando o site estiver publicado atrás de proxy (Render, Railway, Nginx...),
# para o limite de tentativas de login enxergar o IP real de cada jogador.
TRUST_PROXY=0
