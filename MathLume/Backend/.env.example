# Copie este arquivo para ".env" e ajuste. O ".env" NÃO deve ir para o GitHub.
PORT=3000

# ADM criado automaticamente na 1ª vez que o servidor sobe (só se ainda não existir nenhum ADM).
# Se ADMIN_SENHA ficar vazia, uma senha aleatória é gerada e mostrada no console.
ADMIN_USUARIO=admin
ADMIN_EMAIL=admin@mathlume.com
ADMIN_SENHA=

# Coloque 1 se o site ficar atrás de proxy (Render, Railway, Nginx...) para o limite de tentativas ver o IP real.
TRUST_PROXY=0
